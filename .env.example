# Plantilla de configuración. Copiar a `.env` (ignorado por Git) y completar con secretos
# de un ambiente NO productivo obtenidos del Vault. Nunca poner valores reales aquí.

# --- Aplicación ---
NODE_ENV=development
PORT=3000
APP_VERSION=
LOG_LEVEL=info
# Orígenes permitidos por CORS, separados por coma (whitelist explícita).
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Saltos de proxy confiables delante del servicio (ingress/WAF). 0 si se expone directo.
TRUST_PROXY_HOPS=1
# Publica /docs con la especificación OpenAPI (mantener en false en producción).
OPENAPI_DOCS_ENABLED=false
# Habilita DELETE /v1/promotions/cache para vaciar la caché al probar (mantener en false en producción).
CACHE_ADMIN_ENABLED=false

# --- Rate limiting (por IP) ---
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=30
# Límite más bajo para lectura de factura y registro (operaciones costosas o de escritura).
STRICT_RATE_LIMIT_MAX_REQUESTS=10

# --- Archivo de factura ---
MAX_INVOICE_FILE_BYTES=10485760

# --- Azure OpenAI (secreto: key) ---
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
# Nombre del deployment con capacidad de visión (en Azure es el valor del campo `model`).
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2025-04-01-preview
AZURE_OPENAI_TIMEOUT_MS=60000
AZURE_OPENAI_MAX_RETRIES=2

# --- Creatio (secreto: client secret) ---
CREATIO_BASE_URL=
# Endpoint OAuth 2.0 (client credentials) del servicio de identidad de Creatio.
CREATIO_TOKEN_URL=
CREATIO_CLIENT_ID=
CREATIO_CLIENT_SECRET=
CREATIO_TIMEOUT_MS=30000

# --- OpenTelemetry (opcional; se activa solo si hay colector) ---
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_SERVICE_NAME=warranty-registration-bff
